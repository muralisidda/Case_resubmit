# Case Resubmit Application - Environment Configuration Example
# Copy this file to .env and fill in the actual values

# Application Settings
SECRET_KEY=your-secret-key-change-in-production
DEBUG=True
PORT=5000
Environment=ENV3

# Dummy Login Credentials (change before production use)
APP_USERNAME=admin
APP_PASSWORD=admin123

# Platform Support Database (SQL Server)
PLATFORM_DB_DRIVER=ODBC Driver 17 for SQL Server
PLATFORM_DB_SERVER=localhost
PLATFORM_DB_NAME=PlatformSupportDB
PLATFORM_DB_USERNAME=sa
PLATFORM_DB_PASSWORD=

# TIBCO Case Data Database (SQL Server)
TIBCO_DB_DRIVER=ODBC Driver 17 for SQL Server
TIBCO_DB_SERVER=localhost
TIBCO_DB_NAME=tibcodomain
TIBCO_DB_USERNAME=sa
TIBCO_DB_PASSWORD=
