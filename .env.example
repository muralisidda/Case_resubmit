# Case Resubmit Application - Environment Configuration Example
# Copy this file to .env and fill in the actual values

# Application Settings
SECRET_KEY=your-secret-key-change-in-production
DEBUG=True
PORT=5000
Environment=ENV3

# Dummy Login Credentials (change before production use)
APP_USERNAME=admin
APP_PASSWORD=admin123

# Platform Support Database (SQL Server)
PLATFORM_DB_DRIVER=ODBC Driver 17 for SQL Server
PLATFORM_DB_SERVER=localhost
PLATFORM_DB_NAME=PlatformSupportDB
PLATFORM_DB_USERNAME=sa
PLATFORM_DB_PASSWORD=

# TIBCO Case Data Database (SQL Server)
TIBCO_DB_DRIVER=ODBC Driver 17 for SQL Server
TIBCO_DB_SERVER=localhost
TIBCO_DB_NAME=tibcodomain
TIBCO_DB_USERNAME=sa
TIBCO_DB_PASSWORD=

# Optional: TIBCO JMS workflow integration
# Set to True to publish resubmit updates to TIBCO queue from this app.
ENABLE_TIBCO_JMS_RESUBMIT=False

# New credentials location for JMS settings.
# Create config/jms_credentials.json from config/jms_credentials.example.json
# and keep secrets there, or set variables below directly.
JMS_CONFIG_PATH=config/jms_credentials.json

# JMS host settings (used when not provided in JMS config file)
JMS_HOST=localhost
JMS_PORT=7222
JMS_USERNAME=
JMS_PASSWORD=
JMS_USE_SSL=False
JMS_CONNECT_TIMEOUT_SECONDS=10
JMS_REPLY_TIMEOUT_SECONDS=30

# Queue names
JMS_CREATE_CASE_QUEUE=AJBG.FrameworkServices.CreateCase
JMS_UPDATE_CASE_QUEUE=AJBG.FrameworkServices.UpdateCase
JMS_REPLY_QUEUE=AJBG.FrameworkServices.Replies
JMS_DESTINATION_PREFIX=/queue/

# Optional workflow defaults
WORKFLOW_STARTER_DOMAIN=
